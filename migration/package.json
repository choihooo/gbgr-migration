{
  "name": "gbgr-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.12",
  "engines": {
    "node": ">=20.19.0",
    "bun": ">=1.3.12"
  },
  "scripts": {
    "install:dev": "node scripts/install-with-manager.mjs bun",
    "install:release": "node scripts/install-with-manager.mjs npm-ci",
    "install:release:lock": "node scripts/install-with-manager.mjs npm-install",
    "dev": "node ./node_modules/vite/bin/vite.js",
    "build": "node ./node_modules/typescript/bin/tsc && node ./node_modules/vite/bin/vite.js build",
    "build:posture-sidecar": "node scripts/build-posture-sidecar.mjs",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "tauri": "node ./node_modules/@tauri-apps/cli/tauri.js",
    "tauri:dev": "node ./node_modules/@tauri-apps/cli/tauri.js dev",
    "tauri:build": "node ./node_modules/@tauri-apps/cli/tauri.js build",
    "tauri:dev:win": "run-tauri-dev.cmd",
    "tauri:build:win": "run-tauri-build.cmd",
    "tauri:build:debug:win": "run-tauri-build.cmd --debug",
    "lint": "node ./node_modules/@biomejs/biome/bin/biome check --write",
    "lint:check": "node ./node_modules/@biomejs/biome/bin/biome check",
    "format": "node ./node_modules/@biomejs/biome/bin/biome format --write",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node ./node_modules/vitest/vitest.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.99.0",
    "@tauri-apps/api": "2.10",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-deep-link": "^2",
    "@tauri-apps/plugin-http": "^2.5.9",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-updater": "^2",
    "axios": "^1.15.0",
    "clsx": "^2.1.1",
    "i18next": "^26.0.4",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.2",
    "react-router-dom": "^7.14.0",
    "react-webcam": "^7.2.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.3.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.11",
    "@tailwindcss/vite": "^4.2.2",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "^29.0.2",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.4"
  }
}

# API 서버 베이스 URL (미설정 시 기본값: https://api.bugi.co.kr)
VITE_API_BASE_URL=https://api.bugi.co.kr

# 레거시 호환용 별칭 (VITE_API_BASE_URL이 우선됨)
VITE_BASE_URL=https://api.bugi.co.kr

# 오토업데이트 엔드포인트 목록
# 여러 개를 쓸 때는 쉼표(,) 또는 줄바꿈으로 구분합니다.
# 예시:
# VITE_UPDATER_ENDPOINTS=https://github.com/<owner>/<repo>/releases/latest/download/latest.json
# 같은 저장소에서 Electron 릴리스와 함께 운영하면 latest 대상이 섞일 수 있습니다.
# 병행 운영 시에는 Tauri 전용 저장소 또는 별도 정적 호스팅을 권장합니다.
VITE_UPDATER_ENDPOINTS=

# Tauri updater 공개키
# 예시: bunx tauri signer generate 로 만든 public key 내용 전체
VITE_UPDATER_PUBLIC_KEY=
